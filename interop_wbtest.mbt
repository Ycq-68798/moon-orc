///|
test "reject corrupted string files" {
  let direct = open(fixture_text_bad_utf8())
  let dictionary = open(fixture_text_bad_dictionary_index())
  let bad_utf8 = try direct.read_string_column("text") catch {
    Invalid(_) => true
  } noraise {
    _ => false
  }
  let bad_dict = try dictionary.read_string_column("text") catch {
    Invalid(_) => true
  } noraise {
    _ => false
  }
  let bad_type = try direct.read_int_column("text") catch {
    Invalid(_) => true
  } noraise {
    _ => false
  }
  assert_true(bad_utf8 && bad_dict && bad_type)
}

///|
test "Apache Arrow multi string projection" {
  let file = open(fixture_text_multi())
  assert_true(file.stripes.length() > 1)
  let result = file.read_string_column("text")
  for i in 0..<5000 {
    let expected = if i % 7 == 0 { None } else { Some("值-\{i % 17}-🍉") }
    assert_eq(result[i], expected)
  }
}

///|
test "Apache Arrow multi_zlib string projection" {
  let file = open(fixture_text_multi_zlib())
  assert_true(file.stripes.length() > 1)
  let result = file.read_string_column("text")
  for i in 0..<5000 {
    let expected = if i % 7 == 0 { None } else { Some("值-\{i % 17}-🍉") }
    assert_eq(result[i], expected)
  }
}

///|
test "Apache Arrow RLEv2 short" {
  let file = open(fixture_short())
  let (ss, _) = streams(file, file.stripes[0])
  let raw = get_stream(file, ss, 1, 1).unwrap()
  assert_eq(raw[0].to_int() >> 6, 0)
  assert_eq(file.read_int_column("x"), [
    Some(7L),
    Some(7L),
    Some(7L),
    Some(7L),
    Some(7L),
  ])
}

