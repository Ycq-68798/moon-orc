///|
test "reject invalid file" {
  let bad = try open(b"bad") catch {
    Invalid(_) => true
  } noraise {
    _ => false
  }
  let unsupported_codec = try open(fixture_snappy()) catch {
    Invalid(_) => true
  } noraise {
    _ => false
  }
  assert_true(bad && unsupported_codec)
}

///|
test "Long-gap patched-base fixture independently read by Arrow" {
  let file = open(fixture_long_gap())
  let (ss, _) = streams(file, file.stripes[0])
  let raw = get_stream(file, ss, 1, 1).unwrap()
  assert_eq(raw[0].to_int() >> 6, 2)
  let values = file.read_int_column("x")
  for i in 0..<512 {
    assert_eq(values[i], if i == 3 || i == 510 { Some(2L) } else { Some(0L) })
  }
}

///|
test "Apache Arrow string v11_direct" {
  let file = open(fixture_text_v11_direct())
  let (_, encodings) = streams(file, file.stripes[0])
  assert_eq(encodings[1].kind, 0)
  assert_eq(file.read_string_column("text"), [
    Some(""),
    None,
    Some("MoonBit"),
    Some("中文"),
    Some("🍉"),
    Some("MoonBit"),
    Some("x"),
    Some(""),
    Some(" end  "),
    Some("﻿literal"),
    Some(""),
    None,
    Some("MoonBit"),
    Some("中文"),
    Some("🍉"),
    Some("MoonBit"),
    Some("x"),
    Some(""),
    Some(" end  "),
    Some("﻿literal"),
  ])
  assert_eq(file.read_string_column("all_null"), [ for _ in 0..<20 => None ])
}

