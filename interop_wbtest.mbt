///|
test "Apache Arrow ORC 0.11 integers" {
  let file = open(fixture_11())
  assert_eq(file.rows, 15)
  assert_eq(file.stripes.length(), 1)
  assert_eq(file.types[0].names, ["tiny", "small", "big", "empty"])
  assert_eq(file.read_int_column("tiny"), [
    Some(0L),
    Some(-1L),
    Some(7L),
    None,
    Some(-128L),
    Some(127L),
    Some(22L),
    Some(-35L),
    None,
    Some(4L),
    Some(5L),
    Some(6L),
    Some(7L),
    Some(8L),
    Some(9L),
  ])
  assert_eq(file.read_int_column("small"), [
    Some(0L),
    Some(-1L),
    Some(7L),
    None,
    Some(-128L),
    Some(127L),
    Some(22L),
    Some(-35L),
    None,
    Some(4L),
    Some(5L),
    Some(6L),
    Some(7L),
    Some(8L),
    Some(9L),
  ])
  assert_eq(file.read_int_column("big"), [
    Some(0L),
    Some(-1L),
    Some(1099511627776L),
    None,
    Some(-1099511627776L),
    Some(9223372036854775807L),
    Some(-9223372036854775808L),
    Some(42L),
    None,
    Some(1L),
    Some(2L),
    Some(3L),
    Some(4L),
    Some(5L),
    Some(6L),
  ])
  assert_eq(file.read_int_column("empty"), [
    None,
    None,
    None,
    None,
    None,
    None,
    None,
    None,
    None,
    None,
    None,
    None,
    None,
    None,
    None,
  ])
}

