///|
test "Apache Arrow string v12_direct" {
  let file = open(fixture_text_v12_direct())
  let (_, encodings) = streams(file, file.stripes[0])
  assert_eq(encodings[1].kind, 2)
  assert_eq(file.read_string_column("text"), [
    Some(""),
    None,
    Some("MoonBit"),
    Some("中文"),
    Some("🍉"),
    Some("MoonBit"),
    Some("x"),
    Some(""),
    Some(" end  "),
    Some("﻿literal"),
    Some(""),
    None,
    Some("MoonBit"),
    Some("中文"),
    Some("🍉"),
    Some("MoonBit"),
    Some("x"),
    Some(""),
    Some(" end  "),
    Some("﻿literal"),
  ])
  assert_eq(file.read_string_column("all_null"), [ for _ in 0..<20 => None ])
}

