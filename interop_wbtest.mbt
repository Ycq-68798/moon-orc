///|
test "Apache Arrow RLEv2 negative_short" {
  let file = open(fixture_negative_short())
  let (ss, _) = streams(file, file.stripes[0])
  let raw = get_stream(file, ss, 1, 1).unwrap()
  assert_eq(raw[0].to_int() >> 6, 0)
  assert_eq(file.read_int_column("x"), [
    Some(-7L),
    Some(-7L),
    Some(-7L),
    Some(-7L),
    Some(-7L),
  ])
}

///|
test "Apache Arrow RLEv2 direct64" {
  let file = open(fixture_direct64())
  let (ss, _) = streams(file, file.stripes[0])
  let raw = get_stream(file, ss, 1, 1).unwrap()
  assert_eq(raw[0].to_int() >> 6, 1)
  assert_eq(file.read_int_column("x"), [
    Some(-9223372036854775808L),
    Some(9223372036854775807L),
    Some(0L),
    Some(-1L),
    Some(1L),
    Some(12L),
  ])
}

///|
test "Apache Arrow multi-stripe projection" {
  let file = open(fixture_multi())
  assert_eq(file.rows, 5000)
  assert_true(file.stripes.length() > 0)
  let result = file.read_int_column("x")
  for i in 0..<5000 {
    let expected = if i % 7 == 0 {
      None
    } else {
      Some(Int64::from_int(i % 11 - 5))
    }
    assert_eq(result[i], expected)
  }
}

///|
test "Apache Arrow ZLIB large projection" {
  let file = open(fixture_zlib_multi())
  assert_eq(file.rows, 300000)
  assert_true(file.stripes.length() > 0)
  let result = file.read_int_column("x")
  for i in 0..<300000 {
    let expected = if i % 7 == 0 {
      None
    } else {
      Some(Int64::from_int(i % 11 - 5))
    }
    assert_eq(result[i], expected)
  }
}

