///|
test "Apache Arrow ORC 0.11 integers" {
  let file = open(fixture_11())
  assert_eq(file.rows, 15)
  assert_eq(file.stripes.length(), 1)
  assert_eq(file.types[0].names, ["tiny", "small", "big", "empty"])
  assert_eq(file.read_int_column("tiny"), [
    Some(0L),
    Some(-1L),
    Some(7L),
    None,
    Some(-128L),
    Some(127L),
    Some(22L),
    Some(-35L),
    None,
    Some(4L),
    Some(5L),
    Some(6L),
    Some(7L),
    Some(8L),
    Some(9L),
  ])
  assert_eq(file.read_int_column("small"), [
    Some(0L),
    Some(-1L),
    Some(7L),
    None,
    Some(-128L),
    Some(127L),
    Some(22L),
    Some(-35L),
    None,
    Some(4L),
    Some(5L),
    Some(6L),
    Some(7L),
    Some(8L),
    Some(9L),
  ])
  assert_eq(file.read_int_column("big"), [
    Some(0L),
    Some(-1L),
    Some(1099511627776L),
    None,
    Some(-1099511627776L),
    Some(9223372036854775807L),
    Some(-9223372036854775808L),
    Some(42L),
    None,
    Some(1L),
    Some(2L),
    Some(3L),
    Some(4L),
    Some(5L),
    Some(6L),
  ])
  assert_eq(file.read_int_column("empty"), [
    None,
    None,
    None,
    None,
    None,
    None,
    None,
    None,
    None,
    None,
    None,
    None,
    None,
    None,
    None,
  ])
}

///|
test "Apache Arrow ZLIB compressed integers" {
  let file = open(fixture_zlib())
  assert_eq(file.rows, 15)
  assert_eq(file.stripes.length(), 1)
  assert_eq(file.types[0].names, ["tiny", "small", "big", "empty"])
  assert_eq(file.read_int_column("tiny"), [
    Some(0L),
    Some(-1L),
    Some(7L),
    None,
    Some(-128L),
    Some(127L),
    Some(22L),
    Some(-35L),
    None,
    Some(4L),
    Some(5L),
    Some(6L),
    Some(7L),
    Some(8L),
    Some(9L),
  ])
  assert_eq(file.read_int_column("small"), [
    Some(0L),
    Some(-1L),
    Some(7L),
    None,
    Some(-128L),
    Some(127L),
    Some(22L),
    Some(-35L),
    None,
    Some(4L),
    Some(5L),
    Some(6L),
    Some(7L),
    Some(8L),
    Some(9L),
  ])
  assert_eq(file.read_int_column("big"), [
    Some(0L),
    Some(-1L),
    Some(1099511627776L),
    None,
    Some(-1099511627776L),
    Some(9223372036854775807L),
    Some(-9223372036854775808L),
    Some(42L),
    None,
    Some(1L),
    Some(2L),
    Some(3L),
    Some(4L),
    Some(5L),
    Some(6L),
  ])
  assert_eq(file.read_int_column("empty"), [
    None,
    None,
    None,
    None,
    None,
    None,
    None,
    None,
    None,
    None,
    None,
    None,
    None,
    None,
    None,
  ])
}

///|
test "Apache Arrow ORC 0.12 byte and unsupported integer encoding" {
  let file = open(fixture_12())
  assert_eq(file.read_int_column("tiny"), [
    Some(0L),
    Some(-1L),
    Some(7L),
    None,
    Some(-128L),
    Some(127L),
    Some(22L),
    Some(-35L),
    None,
    Some(4L),
    Some(5L),
    Some(6L),
    Some(7L),
    Some(8L),
    Some(9L),
  ])
  let unsupported = try file.read_int_column("small") catch {
    Invalid(_) => true
  } noraise {
    _ => false
  }
  assert_true(unsupported)
}

///|
test "reject invalid file" {
  let bad = try open(b"bad") catch {
    Invalid(_) => true
  } noraise {
    _ => false
  }
  let unsupported_codec = try open(fixture_snappy()) catch {
    Invalid(_) => true
  } noraise {
    _ => false
  }
  assert_true(bad && unsupported_codec)
}

///|
test "Apache Arrow multi-stripe projection" {
  let file = open(fixture_multi())
  assert_eq(file.rows, 5000)
  assert_true(file.stripes.length() > 0)
  let result = file.read_int_column("x")
  for i in 0..<5000 {
    let expected = if i % 7 == 0 {
      None
    } else {
      Some(Int64::from_int(i % 11 - 5))
    }
    assert_eq(result[i], expected)
  }
}

///|
test "Apache Arrow ZLIB large projection" {
  let file = open(fixture_zlib_multi())
  assert_eq(file.rows, 300000)
  assert_true(file.stripes.length() > 0)
  let result = file.read_int_column("x")
  for i in 0..<300000 {
    let expected = if i % 7 == 0 {
      None
    } else {
      Some(Int64::from_int(i % 11 - 5))
    }
    assert_eq(result[i], expected)
  }
}
